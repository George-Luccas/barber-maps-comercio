generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Barbershop {
  id                    String                 @id @default(uuid())
  name                  String
  address               String
  description           String
  imageUrl              String?
  phones                String[]               @default([])
  managerId             String?                @unique
  closingTime           String?
  lunchEnd              String?
  lunchStart            String?
  openingTime           String?
  dailyGoal             Decimal                @default(500.00) @db.Decimal(10, 2)
  photos                String[]               @default([])
  latitude              Float?
  longitude             Float?
  isOpen                Boolean                @default(true)
  aboutUs               String?
  barbers               Barber[]
  products              BarbershopProduct[]
  BarbershopService     BarbershopService[]
  Booking               Booking[]
  FinancialTransactions FinancialTransaction[]
  StockItems            StockItem[]
  styles                Style[]
}

model BarbershopProduct {
  id           String     @id @default(uuid())
  name         String
  description  String?
  imageUrl     String?
  priceInCents Int
  quantity     Int        @default(0)
  barbershopId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
}

model Barber {
  id                    String                 @id @default(uuid())
  name                  String
  email                 String?
  phone                 String?
  imageUrl              String?
  barbershopId          String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  barbershop            Barbershop             @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  bookings              Booking[]
  financialTransactions FinancialTransaction[]

  @@index([barbershopId])
}

model BarbershopService {
  id           String     @id @default(uuid())
  name         String
  description  String
  imageUrl     String
  priceInCents Int
  barbershopId String
  deletedAt    DateTime?
  Barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  Booking      Booking[]
}

model Booking {
  id                String            @id @default(uuid())
  stripeChargeId    String?
  barbershopId      String
  serviceId         String
  userId            String
  date              DateTime          @db.Timestamptz(6)
  cancelledAt       DateTime?         @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(6)
  barberId          String?
  userName          String?
  displayTime       String?
  barber            Barber?           @relation(fields: [barberId], references: [id])
  Barbershop        Barbershop        @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  BarbershopService BarbershopService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model account {
  id         String   @id @default(uuid())
  accountId  String
  providerId String
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String

  @@index([userId])
}

model user {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  password      String?
  phone         String?
  role          UserRole @default(BARBER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model StockItem {
  id           String     @id @default(uuid())
  name         String
  quantity     Int        @default(0)
  minQuantity  Int        @default(5)
  unit         String     @default("un")
  barbershopId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
}

model FinancialTransaction {
  id            String          @id @default(uuid())
  type          TransactionType
  amount        Decimal         @db.Decimal(10, 2)
  description   String
  category      String?
  paymentMethod PaymentMethod   @default(MONEY)
  date          DateTime        @default(now())
  barbershopId  String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  barberId      String?
  barber        Barber?         @relation(fields: [barberId], references: [id])
  barbershop    Barbershop      @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
  @@index([date])
}

model Style {
  id           String     @id @default(uuid())
  name         String
  imageUrl     String
  barbershopId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
}

enum UserRole {
  CLIENT
  BARBER
  ADMIN
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  MONEY
  CARD
  PIX
  OTHER
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Barbershop {
  id                    String                 @id @default(uuid())
  name                  String
  address               String
  description           String
  imageUrl              String?
  phones                String[]               @default([])
  aboutUs               String?
  city                  String?
  closingTime           String?
  dailyGoal             Decimal                @default(500.00) @db.Decimal(10, 2)
  isOpen                Boolean                @default(true)
  isSuspended           Boolean                @default(false)
  latitude              Float?
  longitude             Float?
  lunchEnd              String?
  lunchStart            String?
  managerId             String?                @unique
  openingTime           String?
  photos                String[]               @default([])
  state                 String?
  barbers               Barber[]
  manager               User?                  @relation(fields: [managerId], references: [id])
  products              BarbershopProduct[]
  BarbershopService     BarbershopService[]
  Booking               Booking[]
  FinancialTransactions FinancialTransaction[]
  LoyaltyCard           LoyaltyCard[]
  StockItems            StockItem[]
  styles                Style[]
}

model BarbershopProduct {
  id           String     @id @default(uuid())
  name         String
  description  String?
  imageUrl     String?
  priceInCents Int
  quantity     Int        @default(0)
  barbershopId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
}

model Barber {
  id                    String                 @id @default(uuid())
  name                  String
  email                 String?
  phone                 String?
  imageUrl              String?
  barbershopId          String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  barbershop            Barbershop             @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  bookings              Booking[]
  financialTransactions FinancialTransaction[]

  @@index([barbershopId])
}

model BarbershopService {
  id           String     @id @default(uuid())
  name         String
  description  String
  imageUrl     String
  priceInCents Int
  barbershopId String
  deletedAt    DateTime?
  points       Int        @default(10)
  Barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  Booking      Booking[]
}

model Booking {
  id                String            @id @default(uuid())
  stripeChargeId    String?
  barbershopId      String
  serviceId         String
  userId            String
  date              DateTime          @db.Timestamptz(6)
  cancelledAt       DateTime?         @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(6)
  barberId          String?
  isSubscription    Boolean           @default(false)
  isWelcomeDiscount Boolean           @default(false)
  status            BookingStatus     @default(CONFIRMED)
  userName          String?
  barber            Barber?           @relation(fields: [barberId], references: [id])
  Barbershop        Barbershop        @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  BarbershopService BarbershopService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  UsageLog          UsageLog?
}

model StockItem {
  id           String     @id @default(uuid())
  name         String
  quantity     Int        @default(0)
  minQuantity  Int        @default(5)
  unit         String     @default("un")
  barbershopId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
}

model FinancialTransaction {
  id            String          @id @default(uuid())
  type          TransactionType
  amount        Decimal         @db.Decimal(10, 2)
  description   String
  category      String?
  paymentMethod PaymentMethod   @default(MONEY)
  date          DateTime        @default(now())
  barbershopId  String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  barberId      String?
  barber        Barber?         @relation(fields: [barberId], references: [id])
  barbershop    Barbershop      @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
  @@index([date])
}

model Style {
  id           String     @id @default(uuid())
  name         String
  imageUrl     String
  barbershopId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  accessToken           String?
  accessTokenExpiresAt  DateTime?
  idToken               String?
  password              String?
  refreshToken          String?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model User {
  id                     String             @id @default(uuid())
  name                   String
  email                  String             @unique
  emailVerified          Boolean            @default(false)
  image                  String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  password               String?
  phone                  String?
  phoneExportedAt        DateTime?
  role                   UserRole           @default(BARBER)
  welcomeDiscountClaimed Boolean            @default(false)
  welcomeDiscountUsed    Boolean            @default(false)
  Barbershop             Barbershop?
  LoyaltyCard            LoyaltyCard[]
  PlatformFeedback       PlatformFeedback[]
  account                Account[]
  session                Session[]

  @@map("user")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Notification {
  id        String   @id
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Plan {
  id            String         @id
  name          String
  price         Decimal        @db.Decimal(10, 2)
  service_limit Int
  description   String?
  stripePriceId String?
  Subscription  Subscription[]
}

model Subscription {
  id                      String             @id
  userId                  String             @unique
  planId                  String
  status                  SubscriptionStatus @default(ACTIVE)
  current_balance         Int
  next_billing_date       DateTime           @db.Timestamptz(6)
  gateway_subscription_id String?
  createdAt               DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime           @db.Timestamptz(6)
  Plan                    Plan               @relation(fields: [planId], references: [id])
  UsageLog                UsageLog[]
}

model UsageLog {
  id             String       @id
  subscriptionId String
  bookingId      String       @unique
  date_used      DateTime     @default(now()) @db.Timestamptz(6)
  Booking        Booking      @relation(fields: [bookingId], references: [id])
  Subscription   Subscription @relation(fields: [subscriptionId], references: [id])
}

model LoyaltyCard {
  id                  String      @id
  userId              String
  barbershopId        String
  completedCuts       Int         @default(0)
  freeCuts            Int         @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime
  currentPoints       Int         @default(0)
  tier                LoyaltyTier @default(BRONZE)
  totalLifetimePoints Int         @default(0)
  Barbershop          Barbershop  @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, barbershopId])
}

model PlatformFeedback {
  id        String       @id
  userId    String?
  type      FeedbackType @default(OTHER)
  message   String
  createdAt DateTime     @default(now())
  user      User?        @relation(fields: [userId], references: [id])
}

model Promotion {
  id          String   @id
  title       String
  description String?
  imageUrl    String
  linkUrl     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

enum UserRole {
  CLIENT
  BARBER
  ADMIN
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  MONEY
  CARD
  PIX
  OTHER
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum FeedbackType {
  BUG
  SUGGESTION
  COMPLAIMENT
  OTHER
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
}



model City {
  id        String   @id @default(uuid())
  name      String   @unique
  state     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("city")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  @@map("password_reset_token")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Barbershop {
  id                String              @id @default(uuid())
  name              String
  address           String
  description       String
  imageUrl          String?
  photos            String[]            @default([]) // Galeria de fotos
  phones            String[]            @default([])
  
  // Seus 4 campos de horário mantidos conforme planejado
  openingTime       String?
  lunchStart        String?
  lunchEnd          String?
  closingTime       String?
  isOpen            Boolean             @default(true)
  
  latitude          Float?
  longitude         Float?

  managerId         String?             @unique
  user              user?               @relation(fields: [managerId], references: [id])
  BarbershopService BarbershopService[]
  Booking           Booking[]
  StockItems StockItem[]
  FinancialTransactions FinancialTransaction[]
  
  dailyGoal         Decimal             @default(500.00) @db.Decimal(10, 2)
  aboutUs           String?             @db.Text
  styles            Style[]             // Relação com a Galeria de Estilos
  barbers           Barber[]
  products          BarbershopProduct[] // Frigobar
}

model BarbershopProduct {
  id           String     @id @default(uuid())
  name         String
  description  String?
  imageUrl     String?
  priceInCents Int
  quantity     Int        @default(0)
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([barbershopId])
}

model Barber {
  id           String     @id @default(uuid())
  name         String
  email        String?    
  phone        String?
  imageUrl     String?
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  financialTransactions FinancialTransaction[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([barbershopId])
}

model BarbershopService {
  id           String     @id @default(uuid())
  name         String
  description  String
  imageUrl     String
  priceInCents Int
  barbershopId String
  deletedAt    DateTime?
  Barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  Booking      Booking[]
}

model Booking {
  id                String            @id @default(uuid())
  stripeChargeId    String?
  barbershopId      String
  serviceId         String
  userId            String
  date              DateTime          @db.Timestamptz(6)
  cancelledAt       DateTime?         @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(6)
  
  // A relação garante que o agendamento pertença à barbearia específica da entidade
  Barbershop        Barbershop        @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  BarbershopService BarbershopService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user              user              @relation(fields: [userId], references: [id], onDelete: Cascade)
  barberId          String?
  barber            Barber?           @relation(fields: [barberId], references: [id])
}

model account {
  id         String   @id @default(uuid())
  accountId  String
  providerId String
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model user {
  id            String      @id @default(uuid())
  name          String
  email         String      @unique
  emailVerified Boolean     @default(false)
  image         String?
  password      String?
  phone         String?
  role          UserRole    @default(BARBER)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  // Relação 1:1 - Cada usuário 'BARBER' terá sua própria entidade Barbershop
  Barbershop    Barbershop? 
  Booking       Booking[]
  account       account[]
  session       session[]
}

model verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

enum UserRole {
  CLIENT
  BARBER
  ADMIN
}

model StockItem {
  id           String     @id @default(uuid())
  name         String     // Ex: "Pomada Matte"
  quantity     Int        @default(0)
  minQuantity  Int        @default(5) // Quando chegar aqui, o card avisa
  unit         String     @default("un") // un, pct, ml
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([barbershopId])
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  MONEY
  CARD
  PIX
  OTHER
}

model FinancialTransaction {
  id           String          @id @default(uuid())
  type         TransactionType
  amount       Decimal         @db.Decimal(10, 2)
  description  String
  category     String?         // Ex: "Corte", "Produto", "Aluguel"
  paymentMethod PaymentMethod  @default(MONEY)
  date         DateTime        @default(now())
  
  barbershopId String
  barbershop   Barbershop      @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  
  barberId     String?
  barber       Barber?         @relation(fields: [barberId], references: [id])

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([barbershopId])
  @@index([date])
}

model Style {
  id           String     @id @default(uuid())
  name         String
  imageUrl     String
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([barbershopId])
}